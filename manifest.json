{
  "manifest_version": 3,
  "name": "X All Photo Grid",
  "version": "0.2.1",
  "description": "Show photo-only X posts with more than six images as a three-column grid.",
  "content_scripts": [
    {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["bridge.js"], "run_at": "document_idle", "world": "MAIN"},
    {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "css": ["grid.css"], "run_at": "document_idle"}
  ]
}
